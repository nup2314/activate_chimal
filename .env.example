# Copia este archivo como .env y cambia los valores. NUNCA subas .env a GitHub.

# Clave larga y aleatoria. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto

# Vacío = SQLite local (instance/activate_chimal.db).
# En Render/Neon: postgresql://usuario:clave@host/basededatos?sslmode=require
DATABASE_URL=

# Solo en desarrollo
FLASK_DEBUG=1

# Correo real para enviar códigos de recuperación (Gmail: usa una "contraseña de aplicación")
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_REMITENTE=Activate + Chimal <tu-correo@gmail.com>
